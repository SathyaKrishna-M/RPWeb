  updatedAt  DateTime @updatedAt @map("updated_at")

  map      WorldMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  location WorldLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([mapId, locationId])
  @@index([locationId])
  @@map("map_location_pins")
}

model Tag {
