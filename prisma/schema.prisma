generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  characters   Character[]
  worldMembers WorldMember[]
  worldsOwned  World[]       @relation("WorldOwner")
}

model Character {
  id        String   @id @default(cuid())
  userId    String
  name      String
  avatarUrl String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldMembers WorldMember[]
  messages     Message[]
}

model World {
  id          String   @id @default(cuid())
  name        String
  description String?
  inviteCode  String   @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User             @relation("WorldOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  WorldMember[]
  messages Message[]
  imports  TelegramImport[]
}

model WorldMember {
  id          String   @id @default(cuid())
  worldId     String
  userId      String
  characterId String
  joinedAt    DateTime @default(now())
  role        String   @default("MEMBER") // OWNER, MEMBER

  world     World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([worldId, userId])
}

model Message {
  id          String   @id @default(cuid())
  worldId     String
  characterId String
  content     String
  format      String   @default("NARRATION") // ACTION, DIALOGUE, THOUGHT, NARRATION
  timestamp   DateTime @default(now())
  isImported  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  world     World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([worldId, timestamp])
}

model TelegramImport {
  id         String   @id @default(cuid())
  worldId    String
  uploadedBy String
  status     String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)
}
