enum TelegramImportStatus {
  UPLOADED
  PARSED
  MAPPED
  IMPORTED
  FAILED
  ROLLED_BACK
}

model TelegramImport {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  worldId          String?              @map("world_id") @db.Uuid
  fileName         String               @map("file_name")
  fileHash         String?              @unique @map("file_hash")
  messageCount     Int                  @default(0) @map("message_count")
  participantCount Int                  @default(0) @map("participant_count")
  firstMessageAt   DateTime?            @map("first_message_at")
  lastMessageAt    DateTime?            @map("last_message_at")
  status           TelegramImportStatus @default(UPLOADED)
  errorMessage     String?              @map("error_message")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  createdSceneId   String?              @map("created_scene_id") @db.Uuid

  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  world        World?                      @relation(fields: [worldId], references: [id], onDelete: Cascade)
  createdScene Scene?                      @relation("ImportedScene", fields: [createdSceneId], references: [id], onDelete: SetNull)
  participants TelegramImportParticipant[]
  messages     TelegramImportMessage[]

  @@index([userId])
  @@index([worldId])
  @@index([status])
  @@map("telegram_imports")
}

model TelegramImportParticipant {
  id                String  @id @default(uuid()) @db.Uuid
  importId          String  @map("import_id") @db.Uuid
  telegramName      String  @map("telegram_name")
  mappedCharacterId String? @map("mapped_character_id") @db.Uuid

  import          TelegramImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  mappedCharacter Character?     @relation(fields: [mappedCharacterId], references: [id], onDelete: SetNull)

  @@unique([importId, telegramName])
  @@index([importId])
  @@map("telegram_import_participants")
}

model TelegramImportMessage {
  id                String   @id @default(uuid()) @db.Uuid
  importId          String   @map("import_id") @db.Uuid
  telegramMessageId String?  @map("telegram_message_id")
  senderName        String   @map("sender_name")
  text              String   @db.Text
  timestamp         DateTime
  isSystem          Boolean  @default(false) @map("is_system")
  sequenceNumber    Int      @map("sequence_number")

  import TelegramImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, sequenceNumber])
  @@map("telegram_import_messages")
}

model WorldInviteLink {
