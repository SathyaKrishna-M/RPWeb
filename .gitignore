# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and belongs in the repo.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local SQLite scratch file; the app targets PostgreSQL
dev.db

# Private chat exports kept for reference, not for serving
/samples

# Chat backups. This repo is public — exports must never be committed here.
# `npm run backup` writes into this folder, which is intended to be a clone of
# a SEPARATE PRIVATE repo (see BACKUPS.md).
/backups
