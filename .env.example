# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string. `docker compose up -d` starts one matching this.
DATABASE_URL="postgresql://postgres:password@localhost:5432/rpweb"

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

# Optional. Leave unset and Auth.js derives the origin from the request, which
# works on any port. Set it only for a fixed custom domain.
# NEXTAUTH_URL="https://your-domain.com"
